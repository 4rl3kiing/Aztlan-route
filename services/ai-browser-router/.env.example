# The service is hard-bound to IPv4 loopback; no remote bind override exists.
AZTLAN_ROUTER_PORT=8765
AZTLAN_ROUTER_CATALOG=./config/providers
# Generate a random local bearer token: openssl rand -hex 32
AZTLAN_ROUTER_ACCESS_TOKEN=
# Set provider API keys in the process environment; never put secrets in YAML.
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
