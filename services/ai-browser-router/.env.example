# Bind to loopback by default. Do not expose this service publicly without an auth layer.
AZTLAN_ROUTER_HOST=127.0.0.1
AZTLAN_ROUTER_PORT=8765
AZTLAN_ROUTER_CATALOG=./config/providers
# Set provider API keys in the process environment; never put secrets in YAML.
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
